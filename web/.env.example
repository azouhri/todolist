# Copy to .env.local and fill in the two secrets marked <...>.
# .env.local is gitignored; never commit real values.
#
# Supabase project: jdlhlnxssbgitydguiif
#
# There is no database connection string here on purpose. The app talks to
# Supabase over HTTPS (PostgREST) with supabase-js, so nothing needs direct
# Postgres access — which is also why it works unchanged on Vercel.

# ── Public (browser-safe) ────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API.
# The anon key is designed to be public: RLS plus the sign-in gate are what
# protect the data.

NEXT_PUBLIC_SUPABASE_URL="https://jdlhlnxssbgitydguiif.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Server only ──────────────────────────────────────────────────────────────
# Same page, "service_role" key. It bypasses RLS entirely, so it must never be
# exposed to the browser and must never be prefixed NEXT_PUBLIC_.
#
# Only the local scripts need it: `npm run db:seed`, `npm run db:import`, and
# the MCP server (which has no signed-in user). The web app itself does not use
# it — do NOT add this one to Vercel.

SUPABASE_SERVICE_ROLE_KEY="<SERVICE-ROLE-KEY>"
