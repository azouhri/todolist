.claude/
.agents/
.windsurf/
.cursor/
.vscode/
.idea/
skills-lock.json

# ── Documentation ────────────────────────────────────────────────────────────
# Code only in the repo; the docs stay local.
*.md

# ── Local data ───────────────────────────────────────────────────────────────
# The export holds real colleagues' email addresses — a local backup, not source.
data/
*.db
*.db-journal
*.db-wal

# ── Build artifacts ──────────────────────────────────────────────────────────
mcp/*.mcpb

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
